generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "mysql"

  url      = env("DATABASE_URL")

}



enum PapelUsuario {

  ADMIN

  SUPERVISOR

  ATENDENTE

}



enum StatusChamado {

  ABERTO

  PENDENTE

  EM_ANDAMENTO

  REABERTO

  RESOLVIDO

  FECHADO

}



enum PrioridadeChamado {

  BAIXA

  MEDIA

  ALTA

  URGENTE

}



enum OrigemChamado {

  WHATSAPP

  WEB

  EMAIL

  TELEFONE

}



enum StatusSla {

  NO_PRAZO

  EM_RISCO

  ESTOURADO

  CUMPRIDO

}



enum MotivoPontos {

  CHAMADO_RESOLVIDO

  SLA_CUMPRIDO

  PRIMEIRA_RESPOSTA

  SATISFACAO_CLIENTE

  BONUS

  PENALIDADE

}



model Departamento {

  id           Int      @id @default(autoincrement())

  nome         String

  descricao    String?

  cor          String   @default("#3B82F6")

  ativo        Boolean  @default(true)

  criadoEm     DateTime @default(now())

  atualizadoEm DateTime @updatedAt



  atendentes   Atendente[]

  chamados     Chamado[]

  politicasSla PoliticaSla[]



  @@map("departamento")

}



model Atendente {

  id           Int          @id @default(autoincrement())

  nome         String

  email        String       @unique

  senhaHash    String

  papel        PapelUsuario @default(ATENDENTE)

  avatar       String?

  ativo        Boolean      @default(true)

  pontosTotais Int          @default(0)

  criadoEm     DateTime     @default(now())

  atualizadoEm DateTime     @updatedAt



  idDepartamento Int?

  departamento   Departamento? @relation(fields: [idDepartamento], references: [id])



  chamadosAtribuidos Chamado[]         @relation("AtendenteResponsavel")

  mensagens          MensagemTicket[]

  registrosPontos    RegistroPontos[]

  historico          TicketHistorico[]



  @@map("agente")

}



model PoliticaSla {

  id                      Int               @id @default(autoincrement())

  nome                    String

  prioridade              PrioridadeChamado

  minutosPrimeiraResposta Int

  minutosResolucao        Int

  ativo                   Boolean           @default(true)

  criadoEm                DateTime          @default(now())

  atualizadoEm            DateTime          @updatedAt



  idDepartamento Int?

  departamento   Departamento? @relation(fields: [idDepartamento], references: [id])



  @@unique([idDepartamento, prioridade])

  @@map("politica_sla")

}



model Chamado {

  id            Int               @id @default(autoincrement())

  numeroChamado Int               @unique

  assunto       String

  descricao     String

  status        StatusChamado     @default(ABERTO)

  prioridade    PrioridadeChamado @default(MEDIA)

  origem        OrigemChamado     @default(WHATSAPP)

  statusSla     StatusSla         @default(NO_PRAZO)
 

  nomeSolicitante     String

  telefoneSolicitante String?

  emailSolicitante    String?



  primeiraRespostaEm           DateTime?

  resolvidoEm                  DateTime?

  fechadoEm                    DateTime?

  reabertoEm                   DateTime?

  slaVencimentoEm              DateTime?

  primeiraRespostaVencimentoEm DateTime?



  idChatWhatsapp String?



  criadoEm     DateTime @default(now())

  atualizadoEm DateTime @updatedAt



  idDepartamento      Int?

  departamento        Departamento? @relation(fields: [idDepartamento], references: [id], onDelete: SetNull)

  idAgenteResponsavel Int?

  atendenteResponsavel Atendente?   @relation("AtendenteResponsavel", fields: [idAgenteResponsavel], references: [id], onDelete: SetNull)



  mensagens MensagemTicket[]
  auditorias ChamadoAuditoria[]

  historico TicketHistorico[]

  etiquetas ChamadoEtiqueta[]



  @@map("chamado")

}



model MensagemTicket {

  id                 Int      @id @default(autoincrement())

  conteudo           String

  interno            Boolean  @default(false)

  doAgente           Boolean  @default(false)

  idMensagemWhatsapp String?

  criadoEm           DateTime @default(now())



  idChamado Int

  chamado   Chamado @relation(fields: [idChamado], references: [id], onDelete: Cascade)

  idAgente  Int?

  atendente Atendente? @relation(fields: [idAgente], references: [id])



  @@map("mensagem_ticket")

}



model TicketHistorico {

  id       Int      @id @default(autoincrement())

  acao     String

  detalhes String?

  criadoEm DateTime @default(now())



  idChamado Int

  chamado   Chamado @relation(fields: [idChamado], references: [id], onDelete: Cascade)

  idAgente  Int?

  atendente Atendente? @relation(fields: [idAgente], references: [id])



  @@map("ticket_historico")

}



model Etiqueta {

  id   Int    @id @default(autoincrement())

  nome String



  chamados ChamadoEtiqueta[]



  @@map("etiqueta")

}



model ChamadoEtiqueta {

  idChamado  Int @map("id_chamado")

  idEtiqueta Int @map("id_etiqueta")



  chamado  Chamado  @relation(fields: [idChamado], references: [id], onDelete: Cascade)

  etiqueta Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)



  @@id([idChamado, idEtiqueta])

  @@map("chamado_etiqueta")

}



model RegistroPontos {

  id         Int          @id @default(autoincrement())

  pontos     Int

  motivo     MotivoPontos

  observacao String?

  criadoEm   DateTime     @default(now())



  idAgente  Int

  atendente Atendente @relation(fields: [idAgente], references: [id], onDelete: Cascade)

  idChamado Int?



  @@map("registro_pontos")

}



model SessaoWhatsapp {

  id               Int      @id @default(autoincrement())

  telefone         String   @unique

  nome             String?

  idChamado        Int?

  ultimaMensagemEm DateTime @default(now())

  criadoEm         DateTime @default(now())



  @@map("sessao_whatsapp")

}


model ChamadoAuditoria {
  id          Int      @id @default(autoincrement())
  chamadoId   Int
  chamado     Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  evento      String
  idAgente    Int?
  atendente   Atendente? @relation("AtendenteChamadoAuditoria", fields: [idAgente], references: [id], onDelete: SetNull)
  dadosAntes  Json?
  dadosDepois Json?
  link        String?
  criadoEm    DateTime  @default(now())

  @@map("chamado_auditoria")
  @@index([chamadoId])
  @@index([evento])
  @@index([idAgente])
  @@index([criadoEm])
}


